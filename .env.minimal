# OpenClaw 环境变量配置 - 1GB 内存优化版本
# 复制此文件为 .env 并根据实际情况修改

# ============================================
# Node.js 内存限制
# ============================================
# 限制 Node.js 堆内存为 768MB（为系统保留 256MB+）
NODE_OPTIONS="--max-old-space-size=768"

# ============================================
# 浏览器自动化配置
# ============================================
# 默认禁用浏览器自动化功能以节省内存
OPENCLAW_DISABLE_BROWSER=1

# 如需启用浏览器，注释上行并设置以下参数：
# OPENCLAW_BROWSER_MAX_INSTANCES=1
# OPENCLAW_BROWSER_HEADLESS=true

# ============================================
# 图像处理后端
# ============================================
# Ubuntu 环境使用 sharp（默认）
# OPENCLAW_IMAGE_BACKEND=sharp

# macOS 可选使用系统自带 sips（本配置不适用）
# OPENCLAW_IMAGE_BACKEND=sips

# ============================================
# 消息通道配置
# ============================================
# 跳过除 WhatsApp 外的所有通道加载
OPENCLAW_SKIP_CHANNELS=telegram,discord,slack,signal,line,feishu,imessage

# ============================================
# AI 模型配置
# ============================================
# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # 可选：自定义 API 端点

# 或使用 Gemini API（二选一）
# GEMINI_API_KEY=your_gemini_api_key_here

# 或使用 Anthropic Claude API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# 日志配置
# ============================================
# 减少日志输出以节省资源
OPENCLAW_LOG_LEVEL=warn

# ============================================
# WhatsApp 配置
# ============================================
# WhatsApp 会话数据目录（可选自定义）
# OPENCLAW_WHATSAPP_SESSION_DIR=/home/user/.openclaw/sessions

# ============================================
# 性能优化
# ============================================
# 禁用不必要的功能
OPENCLAW_DISABLE_TUI=1  # 禁用 TUI 界面
OPENCLAW_DISABLE_VOICE=1  # 禁用语音合成

# 限制并发
OPENCLAW_MAX_CONCURRENT_AGENTS=1
OPENCLAW_MAX_CONCURRENT_MEDIA=1

# ============================================
# 运行模式
# ============================================
# 生产环境
NODE_ENV=production

# 配置文件路径（可选）
# OPENCLAW_CONFIG_PATH=/path/to/config.minimal.yaml
